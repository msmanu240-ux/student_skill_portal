{
  "version": 2,
  "functions": {
    "backend/api/*.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    { "src": "/backend/api/(.*)", "dest": "/backend/api/$1" },
    { "src": "/api/(.*)", "dest": "/backend/api/$1.php" },
    { "src": "/frontend/(.*)", "dest": "/frontend/$1" },
    { "src": "/css/(.*)", "dest": "/frontend/css/$1" },
    { "src": "/js/(.*)", "dest": "/frontend/js/$1" },
    { "src": "/images/(.*)", "dest": "/frontend/images/$1" },
    { "src": "/", "dest": "/frontend/index.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
